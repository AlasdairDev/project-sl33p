# Normalise line endings across Linux, Windows and the NTFS mount this was
# developed on. Scripts must keep LF even when checked out on Windows.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.cs   text eol=lf
*.yml  text eol=lf
*.md   text eol=lf

*.png  binary
*.jpg  binary
*.iso  binary
*.qcow2 binary
*.exe  binary
*.dll  binary
